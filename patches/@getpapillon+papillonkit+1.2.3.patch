+    private func performBackgroundHandoff(at now: Date) async -> CourseActivityStatus {
+        await Self.handOff(at: now)
+        return status()
+    }
+
+    private nonisolated static func handOff(at now: Date) async {
+        // ActivityKit keeps an ended activity on screen for at most 4 hours.
+        let latest = now.addingTimeInterval(4 * 60 * 60 - 60)
+        for activity in Activity<CourseActivityAttributes>.activities
+        where activity.activityState == .active && !activity.attributes.preview && activity.attributes.showsAt <= now {
+            let endsAt = activity.content.state.endsAt
+            if endsAt <= now {
+                await activity.end(nil, dismissalPolicy: .immediate)
+            } else {
+                await activity.end(activity.content, dismissalPolicy: .after(min(endsAt, latest)))
+            }
+        }
+    }
+
+    private nonisolated static func dismissHandedOff() async {
+        for activity in Activity<CourseActivityAttributes>.activities where activity.activityState == .ended {
+            await activity.end(nil, dismissalPolicy: .immediate)
+        }
+    }
+
+    private nonisolated static func handedOffCourseIds() -> Set<String> {
